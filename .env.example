# PostgreSQL connection string (docker compose up -d starts a local instance)
DATABASE_URL="postgresql://attest:attest@localhost:5432/attest?schema=public"

# Public URL of this app, used for SnapTrade redirects
APP_URL="http://localhost:3000"

# 32 random bytes, base64 encoded. Encrypts SnapTrade user secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# SnapTrade API credentials (https://dashboard.snaptrade.com)
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
# "personal" for a Personal API key (no user registration, one linked Attest
# account, up to 20 connections) or "commercial" for a Commercial key
# (one SnapTrade user per Attest account).
SNAPTRADE_AUTH_MODE="personal"
# Optional: verify webhooks (value from the SnapTrade dashboard)
SNAPTRADE_WEBHOOK_SECRET=""
# Optional: pin the brokerage slug. When empty the app looks up Wealthsimple by
# name from SnapTrade's brokerage list.
SNAPTRADE_WEALTHSIMPLE_SLUG=""

# Shared secret for the scheduled sync endpoint (/api/cron/sync)
CRON_SECRET=""

# Fallback USD->CAD rate if Bank of Canada Valet is unreachable
FX_FALLBACK_USDCAD="1.36"

# Reporting defaults
DEFAULT_TIMEZONE="America/Toronto"
DEFAULT_BASE_CURRENCY="CAD"
